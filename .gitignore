# Données runtime des conteneurs (cf. CLAUDE.md)
vaultwarden/data/
pihole/etc-pihole/
pihole/etc-dnsmasq.d/
zigbee2mqtt/data/

# Fichier `passwd` Mosquitto (hashes locaux)
mosquitto/config/passwd

# Confs Mosquitto additionnelles, propres au Pi
mosquitto/config/conf.d/*.conf

# Conf ttn-bridge (Python) avec secrets, seul .example est versionné
ttn-bridge/config.json
ttn-bridge/venv/
ttn-bridge/__pycache__/

# Secrets pollux (seuls les .example sont versionnés), état du nœud Tailscale
pollux/.env
pollux/web.env
pollux/ts.env
pollux/ts-state/

# Ansible : inventaire réel, mot de passe et contenu du vault restent locaux
ansible/inventory.yml
ansible/.vault_pass
ansible/host_vars/pidesk/vault.yml
