# Géré par Ansible (role: pollux_url_notify) — ne pas éditer à la main.
[Unit]
Description=Mail à chaque changement d'URL du tunnel pollux
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=true
StateDirectory=pollux-url-notify
EnvironmentFile={{ pollux_url_notify_env_file }}
ExecStart=/usr/bin/python3 {{ pollux_url_notify_install_dir }}/url-notify.py
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
