# Secret partagé avec les clients (même valeur dans leur POLLUX_TOKEN). Il signe
# requêtes et réponses et ne circule jamais. Générer avec : openssl rand -hex 32
POLLUX_TOKEN=<SECRET>

# IP clientes autorisées (page web et /t), séparées par des virgules.
# IP fixes (hors de la maison), jamais modifiées par pollux-allow-ip :
POLLUX_ALLOW_IP_FIXE=
# Générée par pollux-allow-ip (rôle Ansible) : IP fixes + dernières IP publiques
# de la maison (allow-ip-auto). Ne pas éditer à la main ; vide = toutes les IP.
POLLUX_ALLOW_IP=
