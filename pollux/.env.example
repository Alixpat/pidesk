# Secret partagé avec les clients (même valeur dans leur POLLUX_TOKEN). Il signe
# requêtes et réponses et ne circule jamais. Générer avec : openssl rand -hex 32
POLLUX_TOKEN=<SECRET>

# IP clientes autorisées (vues par Cloudflare), séparées par des virgules ; vide = toutes.
# Trouver la sienne : curl -s https://www.cloudflare.com/cdn-cgi/trace | grep ip=
POLLUX_ALLOW_IP=
