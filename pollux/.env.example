# Jeton partagé exigé dans l'en-tête X-Pollux-Token. Le client doit l'envoyer
# (--token ou $POLLUX_TOKEN), sinon HTTP 403. Générer avec : openssl rand -hex 16
POLLUX_TOKEN=<SECRET>

# IP clientes autorisées (vues par Cloudflare), séparées par des virgules ; vide = toutes.
# Trouver la sienne : curl -s https://www.cloudflare.com/cdn-cgi/trace | grep ip=
POLLUX_ALLOW_IP=
