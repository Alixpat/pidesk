# Secret partagé avec les clients (même valeur dans leur POLLUX_TOKEN). Il signe
# requêtes et réponses et ne circule jamais. Générer avec : openssl rand -hex 32
POLLUX_TOKEN=<SECRET>

# IP clientes autorisées (page web et /t), séparées par des virgules ; vide = toutes.
# Trouver la sienne : curl -s https://api.ipify.org
POLLUX_ALLOW_IP=
